{
  "name": "glyph",
  "private": true,
  "version": "0.16.15",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-ts",
    "typecheck": "tsc --noEmit --pretty false",
    "lint:js": "oxlint",
    "lint:js:fix": "oxlint --fix",
    "lint:rust": "scripts/rust-tools.sh lint",
    "lint:rust:fix": "scripts/rust-tools.sh fix",
    "format:rust": "scripts/rust-tools.sh fmt",
    "lint": "bun run lint:js && bun run typecheck",
    "test": "bun test",
    "check": "bun run lint && bun run test",
    "commitlint": "commitlint",
    "release:check": "node scripts/sync-version.mjs --check && scripts/lint-workflows.sh",
    "audit:security": "scripts/security-audit.sh",
    "build": "tsc --noEmit --pretty false && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-version.mjs",
    "version:prerelease": "scripts/version-prerelease.sh",
    "tag-release": "node scripts/tag-release.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
