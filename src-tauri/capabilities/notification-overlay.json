{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notification-overlay",
  "description": "Capability for the separate notification window",
  "windows": ["notification-overlay"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "allow-get-pending-notifications",
    "allow-layout-notification-overlay",
    "allow-dismiss-notification"
  ]
}
