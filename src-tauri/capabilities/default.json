{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "opener:allow-open-url",
    "store:allow-get",
    "store:allow-set",
    "store:allow-load",
    "store:allow-save",
    "store:allow-delete",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "autostart:default",
    "device-info:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        "$DOWNLOAD/**/*",
        "$DOCUMENT/**/*"
      ]
    },
    "allow-reset-activity-timer",
    "allow-set-lock-timeout",
    "allow-set-lock-on-sleep",
    "allow-get-seconds-until-lock",
    "allow-force-lock",
    "allow-get-pending-request",
    "allow-clear-pending-request",
    "allow-accept-pending-request",
    "allow-authorize-pending-request",
    "allow-authorize-callback-message",
    "allow-take-pending-pay",
    "allow-copy-to-clipboard",
    "allow-clear-clipboard",
    "allow-lock-clipboard",
    "allow-post-callback",
    "allow-set-hide-to-tray",
    "allow-get-updater-context",
    "allow-encrypt-store-value",
    "allow-decrypt-store-value",
    "allow-encrypt-vault",
    "allow-unlock-vault-session",
    "allow-verify-vault-password",
    "allow-add-seed-to-vault",
    "allow-remove-seed-from-vault",
    "allow-select-vault-accounts",
    "allow-rotate-vault-password",
    "allow-reveal-vault-seed",
    "allow-store-session-seeds",
    "allow-clear-session-seeds",
    "allow-sign-transaction",
    "allow-sign-local-transaction",
    "allow-sign-message",
    "allow-sign-local-message",
    "allow-sign-callback-message",
    "allow-check-biometric-available",
    "allow-enable-biometric",
    "allow-biometric-unlock",
    "allow-reveal-seed-with-biometric",
    "allow-disable-biometric"
  ]
}
